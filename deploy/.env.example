# Copy to deploy/.env on the server. Do not commit deploy/.env.
# Container path: this must be within /app/data, the mounted persistent volume.
GONGXU_DATABASE_URL=sqlite:////app/data/gongxu.db
GONGXU_DATA_ROOT=/app/data
# Docker Compose host-side runtime data directory and public HTTP listener.
GONGXU_HOST_DATA_DIR=./runtime-data
GONGXU_HTTP_BIND=0.0.0.0
GONGXU_HTTP_PORT=8080
GONGXU_SESSION_SECRET=replace-with-a-random-32-byte-secret
GONGXU_SESSION_TTL_SECONDS=28800
# Keep false for local HTTP / LAN testing. Set true once an HTTPS proxy is configured.
GONGXU_COOKIE_SECURE=false
GONGXU_CSRF_ENABLED=true
GONGXU_MASTER_KEY_HEX=replace-with-64-hex-characters

GONGXU_LLM_MODE=live
GONGXU_LLM_BASE_URL=
GONGXU_LLM_API_KEY=
GONGXU_LLM_MODEL=qwen3.8-max
GONGXU_VISION_BACKEND=qwen
GONGXU_QWEN_SEQUENCE_INPUT_ENABLED=false
GONGXU_PRACTICE_WORKER_ENABLED=true
GONGXU_PRACTICE_TIMEOUT_SECONDS=25
GONGXU_PRACTICE_OBSERVATION_TTL_SECONDS=45
GONGXU_PRACTICE_MAX_CALLS=300
GONGXU_TEACHING_WINDOW_SECONDS=30
GONGXU_TEACHING_MAX_WINDOWS=40
GONGXU_ASR_MODEL=
GONGXU_DEMO_FIXTURES=false
GONGXU_EVIDENCE_RETENTION_DAYS=7

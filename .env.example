# 复制为 .env 使用。生产环境必须覆盖以下占位值。
# 禁止把真实密钥提交到 Git。

# 服务
GONGXU_HOST=127.0.0.1
GONGXU_PORT=8011
GONGXU_LOG_LEVEL=INFO

# 数据库
GONGXU_DATABASE_URL=sqlite:///data/gongxu.db

# 会话与安全（生产必须替换）
GONGXU_SESSION_SECRET=change-me-in-production
GONGXU_SESSION_TTL_SECONDS=28800

# 加密主密钥（64 hex 字符；Windows 生产优先用 DPAPI 包装）
GONGXU_MASTER_KEY_HEX=

# 大模型 Provider：主体功能统一使用 Qwen live；replay 只用于显式契约测试。
GONGXU_LLM_MODE=live
GONGXU_LLM_BASE_URL=
GONGXU_LLM_API_KEY=
GONGXU_LLM_MODEL=qwen3.8-max

# 主体视频事实后端固定为 qwen；缺少凭据时启动脚本会拒绝静默降级。
GONGXU_VISION_BACKEND=qwen
GONGXU_QWEN_SEQUENCE_INPUT_ENABLED=false

# SOP 备课与实时陪练
GONGXU_PRACTICE_WORKER_ENABLED=true
GONGXU_PRACTICE_TIMEOUT_SECONDS=25
GONGXU_PRACTICE_OBSERVATION_TTL_SECONDS=45
GONGXU_PRACTICE_MAX_CALLS=300
GONGXU_TEACHING_WINDOW_SECONDS=30
GONGXU_TEACHING_MAX_WINDOWS=40
# 留空为视觉备课。启用 ASR 前安装 uv sync --extra media --extra teaching。
GONGXU_ASR_MODEL=

# 仅用于离线工程演示，真实考评保持 false。
GONGXU_DEMO_FIXTURES=false

# 隐私保留
GONGXU_EVIDENCE_RETENTION_DAYS=7

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Node
node_modules/
dist/
.vite/
*.local
*.tsbuildinfo
test-results/
playwright-report/
playwright/.cache/

# Local environment / secrets
.env
deploy/.env
.env.*
!.env.example
*.key
*.pem
!windows/**/*.example

# Runtime data — never commit raw data or model weights
data/raw/
data/processed/
data/derivatives/
data/assets/
data/manifests/*.tmp
# 本机授权清单可能包含真人视频路径；只提交文档中的脱敏示例。
data/manifests/qwen-evaluation*.json
models/weights/
*.onnx
*.pth
*.pt
*.bin
*.h5
*.npz

# Media / evidence
*.mp4
*.mov
*.avi
*.mkv
*.webm
!**/*.example.mp4

# SQLite / database
*.db
*.db-wal
*.db-shm
*.sqlite3

# OS
.DS_Store
Thumbs.db

# Reports generated by tests/experiments are commit-worthy facts,
# but scratch output stays out.
reports/generated/*.tmp
reports/scratch/

# Local runtime
.runtime/
.contest/
.cache/
.build/
.playwright-cli/
frontend/.playwright-cli/
output/playwright/
tmp/
deploy/runtime-data/

# Local agent config (not project code)
.claude/

# MediaPipe task bundle (weights, large)
models/*.task
